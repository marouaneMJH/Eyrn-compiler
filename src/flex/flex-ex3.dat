/* Test file for Flex pattern matching program */
/* ================================================== */

/* --------------------------------------------------------- */
/* a) Mots contenant les 5 voyelles a, e, i, o, u dans cet ordre */
/* --------------------------------------------------------- */
/* Valid cases (should match): */
aeiou
abstemious
facetious
adventitious
sacrilegious

/* Invalid cases (should NOT match): */
uoiea
aeioa
hello
world
programming

/* --------------------------------------------------------- */
/* b) Mots sur {a,b} commençant ou finissant par a */
/* --------------------------------------------------------- */
/* Valid cases (should match): */
a
ab
aba
abb
abba
abbba
ba
bba
bbba
aaa
aaab
baaa
abab
baba
/* Invalid cases (should NOT match): */
b
bb
bbb
bab
bbab
babbab

/* --------------------------------------------------------- */
/* c) Mots sur {a,b} sans deux occurrences consécutives du même caractère */
/* --------------------------------------------------------- */
/* Valid cases (should match): */
bababab
ab
ba
aba
bab
abab
baba
ababab
bababa
/* Invalid cases (should NOT match): */
aa
bb
aab
abb
baa
bbb
abba
baab
aabb
abaa

/* --------------------------------------------------------- */
/* d) Mots sur {a,b} ne contenant pas la sous-chaîne 'aba' */
/* --------------------------------------------------------- */
/* Valid cases (should match): */
a
b
ab
bb
aab
abb
abbb
bbb
bbab
bba
aabba
abbba
/* Invalid cases (should NOT match): */
aba
abab
ababa
baba
abaab
babab
aababa

